def escape_latex(text):
    if not isinstance(text, str): text = str(text)
    text = text.replace('="', '').replace('"', '')
    if text.startswith('='): text = text[1:]
    text = text.replace('_', r'\_').replace('%', r'\%').replace('&', r'\&')
    
    rename_dict = {'Obs': 'Observations', 'R2': '$R^2$'}
    if text in rename_dict: return rename_dict[text]
        
    if text.startswith(r'log\_new\_avgq'): return 'Log New Entrant Avg Quality'
    if text.startswith(r'log\_new\_medq'): return 'Log New Entrant Median Quality'
    if text.startswith(r'log\_new\_flowq'): return 'Log New Entrant Flow Volume'
    if text.startswith(r'log\_new\_hhi'): return 'Log New Entrant HHI'
    
    if text.startswith(r'log\_new\_overlap\_count'): return 'Log New Entrant Overlap Volume'
    if text.startswith(r'log\_new\_clone\_count'): return 'Log New Entrant Clone Count'
    if text.startswith(r'log\_new\_clone\_avgq'): return 'Log New Entrant Clone Avg Quality'
    if r'c.log\_new\_clone\_count' in text and '#' in text: return 'Log New Entrant Clone Count $\\times$ Avg Quality'
    
    return text

